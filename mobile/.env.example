# ============================================================
# SMEflow Mobile — Environment Configuration
# Copy to .env.local and fill in values before running.
# NEVER commit .env.local to version control.
# ============================================================

# API base URL — point to your local API server
# Run: ipconfig getifaddr en0  (macOS) to find your LAN IP
# Use LAN IP (not localhost) so the Expo app on a physical device can reach the API
# Production builds must use the HTTPS production API URL.
EXPO_PUBLIC_API_BASE_URL=http://<YOUR_LAN_IP>:8000
