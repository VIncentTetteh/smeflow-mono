# ============================================================
# SMEflow — Environment Configuration
# Copy to .env and fill in real values before running.
# NEVER commit .env to version control.
# ============================================================

# ------ Application ------
APP_ENV=development                         # development | staging | production | test
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-char-random-secret
# Optional: set to old key during key rotation (tokens signed by either are accepted)
SECRET_KEY_PREVIOUS=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15             # short-lived; refresh tokens handle long sessions
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_SECONDS=300                     # 5 minutes
OTP_LENGTH=6
DEBUG_LOG_OTP=false                        # set true in dev to print OTP codes to stdout
OTP_RATE_LIMIT=3                           # max OTP requests per phone per window (raise in dev)
OTP_RATE_WINDOW_SECONDS=3600               # rolling window in seconds (1 hour)

# ------ Admin Security ------
# REQUIRED (non-empty) when APP_ENV=production — server refuses to start without it.
# Example: ADMIN_ALLOWED_IPS=10.0.0.0/8,203.0.113.10
ADMIN_ALLOWED_IPS=
ADMIN_TOTP_ISSUER=SMEFlow Admin

# ------ Database ------
DATABASE_URL=postgresql+asyncpg://smeflow:smeflow@localhost:5432/smeflow
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_RECYCLE=1800                 # seconds before a pooled connection is recycled

# ------ Redis ------
REDIS_URL=redis://localhost:6379/0
OTP_REDIS_DB=1
SESSION_REDIS_DB=2
IDEMPOTENCY_REDIS_DB=3
USSD_REDIS_DB=4

# ------ Celery / RabbitMQ ------
# RABBITMQ_USER and RABBITMQ_PASS are used by docker-compose to configure the
# RabbitMQ container and build service connection URLs dynamically.
RABBITMQ_USER=smeflow
RABBITMQ_PASS=change-me-in-production
RABBITMQ_URL=amqp://smeflow:change-me-in-production@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# ------ Paystack — primary payment rail (MTN MoMo + Vodafone/Telecel + AirtelTigo) ------
# Single API key covers all three Ghana MNOs — no direct MNO credentials required.
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
# Preferred bank for Dedicated Virtual Account (DVA) creation per business
# Options: wema-bank | paystack-titan
PAYSTACK_DVA_PREFERRED_BANK=wema-bank
# Plan codes — populated by running: python -m scripts.seed_paystack_plans
PAYSTACK_STARTER_PLAN_CODE=
PAYSTACK_PRO_PLAN_CODE=

# ------ WhatsApp Business Cloud API ------
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# ------ SMS — Africa's Talking ------
AT_SMS_ENABLED=false
AT_API_KEY=your-africas-talking-key
AT_USERNAME=sandbox
AT_SENDER_ID=SMEFlow
# Set to your AT username to verify incoming delivery-report callbacks.
# Leave blank to skip verification in development.
AT_WEBHOOK_USERNAME=your-at-username
BULK_SMS_DAILY_LIMIT=25

# ------ Push Notifications — Firebase (FCM) ------
FCM_SERVER_KEY=

# ------ Email — Resend ------
RESEND_API_KEY=
RESEND_FROM_EMAIL=SMEflow <noreply@smeflow.app>

# ------ Email — SMTP (e.g. Gmail) ------
# When SMTP_HOST + SMTP_USERNAME + SMTP_PASSWORD are all set, SMTP is used and
# takes precedence over Resend. For Gmail, create an App Password
# (Google Account → Security → 2-Step Verification → App passwords) and use it
# as SMTP_PASSWORD — never your normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ------ Web Push — VAPID ------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER_EMAIL=admin@smeflow.app

# ------ Hubtel — Phone Verification ------
# Uses Hubtel registered-name lookup after OTP login; fail-open when unavailable.
HUBTEL_VERIFY_ENABLED=false
HUBTEL_VERIFY_BASE_URL=https://rnv.hubtel.com
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_ACCOUNT_NUMBER=
HUBTEL_VERIFY_TIMEOUT_SECONDS=10.0

# ------ Hubtel — SMS ------
HUBTEL_SMS_BASE_URL=https://smsc.hubtel.com
HUBTEL_SMS_SENDER_ID=SMEFlow

# ------ Hubtel — OTP ------
HUBTEL_OTP_ENABLED=false
HUBTEL_OTP_BASE_URL=https://api-otp.hubtel.com

# ------ Techieszon SMS ------
TECHIESZON_SMS_ENABLED=false
TECHIESZON_SMS_API_KEY=your-techieszon-api-key
TECHIESZON_SMS_SENDER_ID=Techieszon
TECHIESZON_SMS_BASE_URL=https://smsapp.techieszon.com/sms/api

# ------ Google Sign-In ------
# OAuth client IDs from Google Cloud Console — used to verify Google id_tokens server-side.
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_ID=

# ------ USSD Gateway (Hubtel / Wigal) ------
# Shared secret for HMAC-SHA256 verification on USSD callbacks.
# Leave blank to skip verification in development / sandbox.
USSD_CALLBACK_SECRET=

# ------ GRA (Ghana Revenue Authority) ------
GRA_API_BASE_URL=https://api.gra.gov.gh/v1
GRA_API_KEY=
ENABLE_GRA_DIRECT_FILING=false

# ------ NIA (National Identification Authority — Ghana Card) ------
NIA_API_BASE_URL=https://api.nia.gov.gh/v1
NIA_API_KEY=

# ------ AWS / S3 Storage ------
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=smeflow-assets
AWS_REGION=af-south-1
AWS_S3_PUBLIC_BASE_URL=https://smeflow-assets.s3.af-south-1.amazonaws.com

# ------ xAI / Grok (Chat LLM) ------
XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1

# ------ Groq (Voice / Whisper transcription) ------
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ------ RAG assistant provider switch ------
# groq = OpenAI-compatible, free tier | claude = Anthropic API (paid credits)
AI_PROVIDER=groq

# ------ Anthropic (Claude — used when AI_PROVIDER=claude) ------
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_CHAT_MODEL=claude-opus-5
# low|medium|high|xhigh|max — tunes thinking depth/latency/cost. Set empty to
# disable thinking+effort (required for models without effort, e.g. claude-haiku-4-5).
ANTHROPIC_CHAT_EFFORT=low

# ------ Google Cloud Translation ------
GOOGLE_TRANSLATE_ENABLED=false
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_BASE_URL=https://translation.googleapis.com/language/translate/v2

# ------ Observability — Sentry ------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ------ Observability — OpenTelemetry ------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=smeflow-api
ENABLE_PUBLIC_DOCS=false
ENABLE_PUBLIC_METRICS=false

# ------ Security / Network ------
MAX_REQUEST_BODY_BYTES=1048576
TRUSTED_PROXY_COUNT=0
# Comma-separated IPs/CIDR for webhook source IP filtering.
# In production, supported provider allowlists must be non-empty.
WEBHOOK_ALLOWED_IPS_PAYSTACK=
WEBHOOK_ALLOWED_IPS_AT=
WEBHOOK_ALLOWED_IPS_HUBTEL=

# ------ App URL ------
APP_BASE_URL=https://app.smeflow.com

# ------ Lender Partner API ------
# JSON dict mapping lender_id to sha256(api_key): {"lender_id": "hash", ...}
LENDER_API_KEYS={}
LENDER_API_KEY_EXPIRY_DAYS=90
LENDER_API_KEY_EXPIRY_ALERT_DAYS=14
LENDER_ORIGINATION_FEE_RATE_PERCENT=2.0

# ------ Freemium Plan Limits ------
FREE_TIER_MONTHLY_SALES=-1
FREE_TIER_ITEMS=50
FREE_TIER_EMPLOYEES=0

# ------ Operations / Circuit Breaker ------
AGENT_COMMISSION_MIN_PAYOUT_GHS=10.0
BILLING_GRACE_DAYS=3
# Merchant settlement — min withdrawal, auto-approve ceiling, default auto-settlement threshold
SETTLEMENT_MIN_GHS=10.0
SETTLEMENT_AUTO_APPROVE_CEILING_GHS=5000.0
SETTLEMENT_DEFAULT_THRESHOLD_GHS=50.0
# Legacy direct MoMo agent payout — must stay false in production
ENABLE_LEGACY_AGENT_MOMO_PAYOUT=false
# Canonical Paystack webhook (configure in Paystack Dashboard → Developers → Webhooks):
#   {API_PUBLIC_BASE}/api/v1/payments/webhooks/paystack
# Example local: http://localhost:8000/api/v1/payments/webhooks/paystack (requires a tunnel)
PAYSTACK_WEBHOOK_URL=http://localhost:8000/api/v1/payments/webhooks/paystack
CREDIT_SCORE_MAX_AGE_HOURS=168            # 7 days
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_OPEN_SECONDS=60

# ------ Feature Flags ------
ENABLE_CREDIT_SCORING=true
ENABLE_USSD=false
ENABLE_ANALYTICS_PREMIUM=false
ENABLE_ANALYTICS_BENCHMARKING=false

# ------ GRA Tax Rates (Ghana 2025) ------
VAT_RATE=0.125                            # 12.5% standard rate
NHIL_RATE=0.025                           # 2.5% National Health Insurance Levy
GETFUND_RATE=0.01                         # 1.0% Ghana Education Trust Fund
COVID_LEVY_RATE=0.01                      # 1.0% COVID-19 Health Recovery Levy
